// "Grass Block": UI theme for the Minecraft Dev plugin — the dark IDE base
// with a grass-green accent and diamond-teal selection. Keys are the CSS
// variables of openidea/src/styles/tokens.css; delete a line to keep the
// built-in value of the base named by "kind". Comments (// and /* */) allowed.
{
  "id": "grass-block",
  "name": "Grass Block",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#11160f",
    "--bg-elev": "#171f16",
    "--bg-popup": "#1c251b",
    "--bg-floating-toolbar": "#1c251b",
    "--bg-hover": "#222d20",
    "--bg-selected": "#234a26",
    "--bg-selected-strong": "#2c5a31",
    "--bg-current-line": "#151d13",
    "--bg-debug-line": "#245a2c",
    "--bg-backdrop": "#1c251b",
    "--bg-input": "#11160f",

    // Lines
    "--border": "#1c251b",
    "--border-popup": "#283527",
    "--border-strong": "#34462f",
    "--border-window": "#34462f",
    "--control-off": "#51614b",

    // Text
    "--fg-strong": "#d9e6d9",
    "--fg-emphasis": "#c9dcc9",
    "--fg": "#c9dcc9",
    "--fg-secondary": "#93ac93",
    "--fg-muted": "#7f967f",
    "--fg-subtle": "#677c67",
    "--fg-faint": "#51614b",
    "--fg-gutter": "#3f4d3a",
    "--fg-icon": "#c4d4c4",

    // Accent (grass green)
    "--accent": "#4f9e3a",
    "--link": "#6fc45f",
    "--link-hover": "#95d98a",

    // Charts
    "--chart-series": "#7fc46b",

    // Status
    "--danger": "#f07070",
    "--warning": "#c9963c",
    "--success": "#5fb06f",
    "--db-connected": "#2fe02f",
    "--db-connected-ring": "#1d6b1d",
    "--info": "#58b0c2",

    // Vcs
    "--vcs-modified": "#82ed82",
    "--vcs-added": "#73bd79",
    "--vcs-deleted": "#5f6f5f",
    "--vcs-untracked": "#e88f89",
    "--vcs-ignored": "#d69a6b",
    "--vcs-conflict": "#de6a66",
    "--gutter-modified": "#469e3a",
    "--gutter-added": "#549159",
    "--gutter-deleted": "#75866f",
    "--diff-modified": "#2f4f3d",
    "--diff-inserted": "#29443a",
    "--diff-deleted": "#43494a",

    // Additive
    "--bg-tooltip": "#283527",
    "--fg-tooltip": "#c9dcc9",
    "--border-tooltip": "#283527",
    "--bg-control": "#1c251b",
    "--bg-control-hover": "#283527",
    "--bg-active": "#34462f",
    "--bg-scrim": "rgba(0, 0, 0, 0.45)",
    "--fg-on-accent": "#ffffff",
    "--bg-tab-selected": "#1e3d20",
    "--border-tab-selected": "#4f9e3a",
    "--bg-tab-selected-inactive": "#1c251b",
    "--border-tab-selected-inactive": "#34462f",
    "--bg-tab-hover": "#ffffff17",
    "--border-editor-tabs": "#1c251b",
    "--bg-tree-selected": "#234a26",
    "--bg-tree-selected-inactive": "#283527",
    "--bg-tree-hover": "#ffffff10",
    "--bg-toolbar-hover": "#ffffff17",
    "--bg-toolbar-pressed": "#ffffff29",
    "--bg-toolbar-selected": "#2c5a31",
    "--bg-toolbar-selected-hover": "#346b3a",
    "--bg-button-primary-hover": "#409c68",
    "--fg-button-primary": "#ffffff",
    "--bg-button": "transparent",
    "--border-button": "#34462f",
    "--bg-field": "#11160f",
    "--bg-checkbox": "#11160f",
    "--border-checkbox": "#51614b",
    "--bg-toggle-on": "#338555",
    "--fg-toggle-on": "#ffffff",
    "--bg-toggle-off": "#11160f",
    "--fg-toggle-off": "#677c67",
    "--border-toggle": "#51614b",
    "--bg-toggle-knob": "#51614b",
    "--focus-ring-soft": "#43783a",
    "--scrollbar-thumb": "#ffffff33",
    "--scrollbar-thumb-hover": "#ffffff59",
    "--bg-search-match": "#8a9d3f",
    "--bg-search-match-current": "#c2d15c",
    "--fg-search-match": "#11160f",
    "--bg-dialog": "#11160f",
    "--bg-popup-inline": "#1c251b",
    "--bg-popup-advertiser": "#1c251b",
    "--bg-feedback-info": "#2a514f",
    "--border-feedback-info": "#397e79",
    "--bg-feedback-error": "#56272b",
    "--border-feedback-error": "#80383e",
    "--bg-feedback-warning": "#403020",
    "--border-feedback-warning": "#65512a",
    "--bg-feedback-success": "#1f3a24",
    "--border-feedback-success": "#29583c",
    "--bg-counter": "#677c67",
    "--fg-counter": "#000000",
    "--bg-progress-track": "#34462f",
    "--bg-frame": "#1c251b",
    "--bg-island": "#11160f",
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.45)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.6), 0 10px 24px rgba(0, 0, 0, 0.35), 0 24px 72px rgba(0, 0, 0, 0.45)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#404955",
    "--traffic-off-border": "#363e49",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.45)",
    "--border-tooltip": "#283527"
  }
}
